# Шаблон конфигурации. Скопируй в .env и подставь реальные значения.
# Сам .env в репозиторий не попадает (см. .gitignore).

# --- Telegram ----------------------------------------------------------------
# Токен бота от @BotFather
BOT_TOKEN=

# Белый список: числовые Telegram ID через запятую.
# Свой ID можно узнать у бота @userinfobot.
ALLOWED_USER_IDS=

# --- Время -------------------------------------------------------------------
# Часовой пояс пользователя в формате IANA (Europe/Moscow, Asia/Yekaterinburg, ...).
# Сервер живёт в UTC, а напоминания должны срабатывать по твоему времени.
TZ=Europe/Moscow

# --- Модель ------------------------------------------------------------------
# Ключ Groq: https://console.groq.com/keys
GROQ_API_KEY=

# Адрес API. Groq совместим с протоколом OpenAI, поэтому сменить провайдера
# можно, поменяв только эту строку и название модели.
LLM_BASE_URL=https://api.groq.com/openai/v1

# Основная модель. Проверенные альтернативы на Groq:
#   llama-3.3-70b-versatile — точнее считает даты, но склонна к лишним вызовам функций
#   llama-3.1-8b-instant    — заметно быстрее и слабее, годится для простых задач
#   groq/compound           — со встроенным веб-поиском
LLM_MODEL=openai/gpt-oss-120b

# Разброс ответов: 0 — предсказуемо и сухо, 1 — творчески и непредсказуемо.
LLM_TEMPERATURE=0.4

# Сколько секунд ждать ответа модели, прежде чем сдаться.
LLM_TIMEOUT_SECONDS=60

# --- Голосовые ---------------------------------------------------------------
# Модель распознавания речи. Доступна на том же ключе Groq.
#   whisper-large-v3-turbo — быстрее и экономнее по лимитам
#   whisper-large-v3       — чуть точнее на сложном аудио
STT_MODEL=whisper-large-v3-turbo

# Язык голосовых. Явное указание повышает точность.
# Пустое значение включает автоопределение.
STT_LANGUAGE=ru

# Максимальная длительность голосового в секундах.
MAX_VOICE_SECONDS=300

# --- Поиск в интернете -------------------------------------------------------
# Сколько результатов забирать из выдачи.
SEARCH_MAX_RESULTS=5

# Регион выдачи: ru-ru даёт русскоязычные источники и местные сайты.
SEARCH_REGION=ru-ru

# Предел ожидания поиска в секундах.
SEARCH_TIMEOUT_SECONDS=20

# --- Напоминания -------------------------------------------------------------
# Как часто планировщик проверяет базу. Это же и точность срабатывания.
REMINDER_TICK_SECONDS=30

# Если бот был выключен, просроченные напоминания придут при запуске —
# но только если опоздание меньше этого срока в днях.
MISSED_REMINDER_GRACE_DAYS=7

# Предохранитель от зацикливания: сколько вызовов инструментов подряд
# модель может сделать в рамках одного сообщения.
MAX_TOOL_ROUNDS=5

# --- Диалог ------------------------------------------------------------------
# Через сколько минут молчания разговор считается законченным.
# Утренний вопрос про историю и вечерний про SQL не должны быть одним диалогом.
SESSION_TTL_MINUTES=120

# Сколько последних реплик отправлять модели вместе с новым сообщением.
MAX_HISTORY_MESSAGES=20
