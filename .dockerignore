# Что НЕ попадает в образ.

# Секреты. Ключевой пункт: образ можно выгрузить, переслать, залить в реестр —
# и вшитый токен уедет вместе с ним. Переменные передаются при запуске
# (env_file в docker-compose.yml), а не запекаются внутрь.
.env

# Виртуальное окружение с Windows-бинарниками, в Linux бесполезными.
.venv/

# Локальная база. В контейнере данные живут в подключённой папке, а не в образе.
data/

# История репозитория — лишние мегабайты.
.git/
.gitignore
.gitattributes

# Настройки IDE и кэш Python.
.idea/
__pycache__/
*.py[cod]

# Документация в рантайме не нужна.
README.md
